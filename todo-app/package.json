{
  "name": "todo-app",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
   "dev": "node_modules\\.bin\\vite.cmd",
   "build": "node_modules\\.bin\\vite.cmd build",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:1420 && electron .\"",
    "electron:build": "node_modules\\.bin\\vite.cmd build && set \"ELECTRON_BUILDER_CACHE=%cd%\\.eb-cache\" && node_modules\\.bin\\electron-builder.cmd build --win"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "vite": "^6.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "concurrently": "^9.0.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.todo.app",
    "productName": "Todo",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
